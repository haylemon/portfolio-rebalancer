{
  "name": "portfolio-rebalancer",
  "version": "1.0.0",
  "description": "Portfolio rebalancing simulator demonstrating PostgreSQL transactions, row locking, and async job processing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "seed": "psql $DATABASE_URL -f scripts/seed.sql"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
