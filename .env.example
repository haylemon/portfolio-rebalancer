DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/portfolio_rebalancer
PORT=3000
NODE_ENV=development

# Log verbosity. Options: error | warn | info | debug
# info  — request logs, job lifecycle events (default)
# debug — adds per-trade logs, transaction begin/commit, poll events
# error — only errors (useful in test environments)
LOG_LEVEL=info
